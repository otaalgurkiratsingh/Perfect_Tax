# Environment variables — NAMES ONLY. Set real values in Netlify (Site settings → Environment variables)
# and in .env.local for local development. Never commit values.

# Supabase (project MUST be in the Canada region: ca-central-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app, e.g. https://intake.example.ca (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Security secrets (generate with: openssl rand -base64 32)
SIN_ENCRYPTION_KEY=
LINK_SIGNING_SECRET=
CRON_SECRET=

# Cloudflare Turnstile (anti-spam on the public start page)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=

# SMS + WhatsApp (Twilio). Use either TWILIO_SMS_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# "live" sends real email/SMS/WhatsApp. Anything else = dry run (logged, not sent).
MESSAGING_MODE=

# LOCAL ONLY — never set on Netlify. INSECURE_LOCAL_TESTING=1 lets the automated test run skip
# Turnstile and write full dry-run messages (with links) to DEV_OUTBOX_DIR.
INSECURE_LOCAL_TESTING=
DEV_OUTBOX_DIR=
